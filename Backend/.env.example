PGUSER=postgres
PGPASSWORD=change-me
PGHOST=localhost
PGPORT=5433
PGDATABASE=dayflow
PORT=5000
NODE_ENV=development

# Use this instead of PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD with Neon,
# Supabase, Railway, Render, or another hosted PostgreSQL provider.
# DATABASE_URL=postgresql://user:password@host:5432/dayflow?sslmode=require
# DATABASE_SSL=false

# Required for secure sign-in sessions (use a long random value)
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Required to deliver OTPs to personal email addresses
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Dayflow <no-reply@example.com>
