PGUSER=postgres
PGPASSWORD=change-me
PGHOST=localhost
PGPORT=5433
PGDATABASE=dayflow
PORT=5000
NODE_ENV=development

# Required for secure sign-in sessions (use a long random value)
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Required to deliver OTPs to personal email addresses
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Dayflow <no-reply@example.com>
